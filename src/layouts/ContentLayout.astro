---
import BaseLayout from "./BaseLayout.astro";
import InnerHeroSignal from "../components/InnerHeroSignal.astro";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  currentPath: string;
  title: string;
  description: string;
}
const props = Astro.props;
---

<BaseLayout {...props}>
  <div class="content-shell container">
    {props.locale === "ru" && <InnerHeroSignal variant="record" />}
    <article><slot /></article>
  </div>
</BaseLayout>
