---
import type { Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
  site: import("astro:content").CollectionEntry<"site">["data"];
}

const { locale, site } = Astro.props;
const isRu = locale === "ru";
const prefix = isRu ? "/ru" : "";
---

<section class="dual-hero" aria-labelledby="hero-title">
  <div class="dual-hero-copy">
    <p class="eyebrow">{site.hero.eyebrow}</p>
    <h1 id="hero-title">{site.hero.title}</h1>
    {site.hero.lead && <p class="hero-lead">{site.hero.lead}</p>}
    <div class="hero-footer">
      <a class="button" href={`${prefix}/contact/`}>{site.hero.primaryCta}</a>
      <p class="hero-fact">{site.hero.metaFact}</p>
    </div>
  </div>

  <aside class="site-atlas" data-testid="hero-selected-work" data-site-atlas aria-label="Real Povkh.Dev websites in different visual directions">
    <p class="atlas-kicker">Real work / different systems</p>
    <a class="atlas-shot atlas-kzms" href="/ru/work/kzms/" aria-label="Open the KZMS website case study in Russian">
      <span>KZMS <i>Industrial ↗</i></span>
      <img src="/assets/editorial/atlas-kzms.webp" alt="Redesigned KZMS industrial mesh catalogue" width="480" height="320" decoding="async" loading="lazy" fetchpriority="low" />
    </a>
    <a class="atlas-shot atlas-endokey" href="/work/endokey/" aria-label="Open the ENDOkey website case study">
      <span>ENDOkey <i>Medical ↗</i></span>
      <img src="/assets/editorial/atlas-endokey.webp" alt="ENDOkey medical product website homepage" width="480" height="320" decoding="async" loading="lazy" fetchpriority="low" />
    </a>
    <a class="atlas-shot atlas-lab" href="/work/povkh-lab/" aria-label="Open the POVKH LAB website case study">
      <span>POVKH LAB <i>Music ↗</i></span>
      <img src="/assets/editorial/atlas-povkh-lab.webp" alt="POVKH LAB multilingual website homepage" width="360" height="896" decoding="async" loading="lazy" fetchpriority="low" />
    </a>
    <p class="atlas-range">Industrial / medical / music<br />One method — different visual languages</p>
  </aside>
</section>

<script>
  const atlas = document.querySelector<HTMLElement>("[data-site-atlas]");
  if (atlas && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let frame = 0;
    const resetAtlas = () => {
      cancelAnimationFrame(frame);
      atlas.style.setProperty("--atlas-x", "0");
      atlas.style.setProperty("--atlas-y", "0");
    };
    atlas.addEventListener("pointermove", (event) => {
      if (event.pointerType === "touch") return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const bounds = atlas.getBoundingClientRect();
        atlas.style.setProperty("--atlas-x", String(((event.clientX - bounds.left) / bounds.width - 0.5) * 2));
        atlas.style.setProperty("--atlas-y", String(((event.clientY - bounds.top) / bounds.height - 0.5) * 2));
      });
    });
    atlas.addEventListener("pointerleave", resetAtlas);
  }
</script>

<style>
  .dual-hero {
    display: grid;
    min-height: min(50rem, calc(100svh - 7rem));
    border-bottom: 1px solid var(--ink);
    grid-template-columns: minmax(0, 7fr) minmax(21rem, 5fr);
  }
  .dual-hero-copy {
    display: grid;
    min-width: 0;
    padding: clamp(3rem, 6vw, 6.5rem) var(--gutter);
    grid-template-rows: auto 1fr auto;
  }
  h1 {
    max-width: 16ch;
    margin: clamp(3rem, 8vh, 6.5rem) 0 var(--space-7);
    align-self: center;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 4.65vw, 5rem);
    font-weight: 650;
    letter-spacing: -0.065em;
    line-height: 0.96;
  }
  .hero-lead {
    max-width: 42rem;
    margin: 0 0 var(--space-6);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
  }
  .hero-footer {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }
  .hero-fact {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .site-atlas {
    --atlas-x: 0;
    --atlas-y: 0;
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-left: 1px solid var(--ink);
    background:
      linear-gradient(color-mix(in srgb, var(--ink) 9%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--ink) 9%, transparent) 1px, transparent 1px),
      var(--signal-blue, #c9deeb);
    background-size: 42px 42px;
    perspective: 1200px;
    isolation: isolate;
  }
  .site-atlas::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(135deg, rgb(255 255 255 / 28%), transparent 42%, rgb(255 47 146 / 8%));
    content: "";
    pointer-events: none;
  }
  .atlas-kicker,
  .atlas-range {
    position: absolute;
    z-index: 8;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .atlas-kicker { top: 5%; left: 5%; }
  .atlas-range { right: 4%; bottom: 3.5%; text-align: right; }
  .atlas-shot {
    position: absolute;
    display: grid;
    overflow: hidden;
    border: 1px solid var(--ink);
    color: var(--paper);
    background: var(--ink);
    box-shadow: 0 24px 60px rgb(20 19 22 / 22%);
    grid-template-rows: 30px 1fr;
    text-decoration: none;
    transform-style: preserve-3d;
    transition: transform 220ms cubic-bezier(.2,.8,.2,1), box-shadow 150ms ease-out, filter 150ms ease-out;
    will-change: transform;
  }
  .atlas-shot:hover { z-index: 7; filter: saturate(1.08); box-shadow: 0 32px 74px rgb(20 19 22 / 30%); }
  .atlas-shot:focus-visible { z-index: 9; outline: 3px solid var(--signal-pink, #ff2f92); outline-offset: 4px; }
  .atlas-shot:active { filter: brightness(.92); }
  .atlas-shot span {
    display: flex;
    padding-inline: 10px;
    align-items: center;
    justify-content: space-between;
    color: var(--paper);
    background: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .atlas-shot span i { color: #ff77b9; font-style: normal; }
  .atlas-shot img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .atlas-kzms { z-index: 2; top: 10%; left: 5%; width: 68%; height: 45%; transform: translate3d(calc(var(--atlas-x) * -7px), calc(var(--atlas-y) * -5px), 0) rotate(-3.5deg); }
  .atlas-endokey { z-index: 5; top: 31%; right: 4%; width: 58%; height: 44%; transform: translate3d(calc(var(--atlas-x) * 10px), calc(var(--atlas-y) * 7px), 34px) rotate(2.5deg); }
  .atlas-lab { z-index: 4; bottom: 6%; left: 13%; width: 51%; height: 35%; transform: translate3d(calc(var(--atlas-x) * -4px), calc(var(--atlas-y) * 9px), 16px) rotate(-1deg); }
  @media (max-width: 64rem) {
    .dual-hero { min-height: auto; grid-template-columns: minmax(0, 1fr); }
    .dual-hero-copy { min-height: min(42rem, calc(100svh - 7rem)); padding-block: var(--space-7); }
    h1 { max-width: 15ch; margin-block: var(--space-7); font-size: clamp(2.55rem, 8.6vw, 4.7rem); }
    .site-atlas { min-height: 32rem; border-top: 1px solid var(--ink); border-left: 0; }
  }
  @media (max-width: 36rem) {
    .dual-hero-copy { min-height: 35rem; }
    h1 { font-size: clamp(2.2rem, 10.8vw, 3.5rem); line-height: 0.98; }
    .hero-footer { align-items: flex-start; flex-direction: column; }
    .site-atlas { min-height: 29rem; }
    .atlas-shot { grid-template-rows: 26px 1fr; }
    .atlas-kzms { top: 11%; left: 4%; width: 72%; height: 40%; }
    .atlas-endokey { top: 34%; right: 2%; width: 63%; height: 39%; }
    .atlas-lab { bottom: 7%; left: 9%; width: 58%; height: 31%; }
    .atlas-range { font-size: 0.44rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .atlas-shot { transition: none; will-change: auto; }
  }
</style>
