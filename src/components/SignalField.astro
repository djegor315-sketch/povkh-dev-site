---
interface Props {
  variant: string;
  compact?: boolean;
  caseField?: boolean;
}

const { variant, compact = false, caseField = false } = Astro.props;
---

<div
  class:list={["signal-field", { compact }]}
  data-signal-field
  data-case-field={caseField ? "" : undefined}
  data-variant={variant}
  aria-hidden="true"
>
  <span class="field-orbit"></span>
  <span class="field-axis axis-a"></span>
  <span class="field-axis axis-b"></span>
  <span class="field-core"></span>
  <span class="field-trace trace-a"></span>
  <span class="field-trace trace-b"></span>
  <span class="field-bars">
    {Array.from({ length: 12 }, (_, index) => <i style={`--i:${index}`}></i>)}
  </span>
</div>

<style>
  .signal-field {
    --field-accent: #ff2f92;
    --field-secondary: #8a5bff;
    position: relative;
    min-width: 0;
    min-height: 12rem;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 0.8rem;
    background:
      radial-gradient(circle at 68% 48%, color-mix(in srgb, var(--field-accent) 20%, transparent), transparent 35%),
      linear-gradient(115deg, rgb(255 255 255 / 0.045), transparent 44%),
      rgb(8 7 10 / 0.78);
    isolation: isolate;
  }
  .signal-field::before {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    background-image: linear-gradient(rgb(255 255 255 / 0.22) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.22) 1px, transparent 1px);
    background-size: 2.25rem 2.25rem;
    mask-image: linear-gradient(90deg, black, transparent 78%);
    content: "";
  }
  .compact { min-height: 8.5rem; border: 0; border-bottom: 1px solid rgb(255 255 255 / 0.12); border-radius: 0; background-color: transparent; }
  .field-orbit { position: absolute; top: 50%; left: 67%; width: 8rem; aspect-ratio: 1; border: 1px solid rgb(255 255 255 / 0.26); border-radius: 50%; transform: translate(-50%, -50%); }
  .field-orbit::before, .field-orbit::after { position: absolute; border-radius: 50%; content: ""; }
  .field-orbit::before { inset: 18%; border: 1px dashed color-mix(in srgb, var(--field-accent) 78%, transparent); }
  .field-orbit::after { top: 50%; left: 50%; width: 0.55rem; aspect-ratio: 1; background: #f7f3f5; box-shadow: 0 0 1.5rem var(--field-accent); transform: translate(-50%, -50%); }
  .field-axis { position: absolute; left: 12%; width: 67%; height: 1px; background: linear-gradient(90deg, transparent, var(--field-accent), transparent); transform-origin: 70% 50%; }
  .axis-a { top: 39%; transform: rotate(-9deg); }
  .axis-b { top: 64%; opacity: 0.55; transform: rotate(7deg); }
  .field-core { position: absolute; top: 36%; left: 24%; width: 1rem; aspect-ratio: 1; border: 2px solid var(--field-accent); border-radius: 50%; box-shadow: 0 0 1.4rem var(--field-accent); }
  .field-trace { position: absolute; height: 0.45rem; border-radius: 999px; background: var(--field-accent); box-shadow: 0 0 1rem color-mix(in srgb, var(--field-accent) 60%, transparent); }
  .trace-a { top: 25%; right: 9%; width: 4rem; transform: rotate(46deg); }
  .trace-b { right: 4%; bottom: 18%; width: 6rem; transform: rotate(-31deg); }
  .field-bars { position: absolute; bottom: 15%; left: 8%; display: flex; height: 34%; align-items: end; gap: 0.32rem; }
  .field-bars i { width: 0.22rem; height: calc(18% + var(--i) * 5%); background: color-mix(in srgb, var(--field-secondary) 74%, #f7f3f5); opacity: calc(0.3 + var(--i) * 0.045); }

  [data-variant*="brand"], [data-variant*="studio"] { --field-secondary: #ff86bf; }
  [data-variant*="site"], [data-variant*="kzms"] { --field-secondary: #9f79ff; }
  [data-variant*="connect"], [data-variant*="endokey"] { --field-secondary: #f7f3f5; }
  [data-variant*="lab"] { --field-secondary: #ff2f92; }
  [data-variant*="giulia"] { --field-accent: #ff7fb9; --field-secondary: #f7f3f5; }
  [data-variant*="stage"] .field-orbit { width: 5.5rem; }
  [data-variant*="stage"] .field-bars { left: auto; right: 9%; height: 48%; }
  [data-variant*="stage"] .trace-a { left: 8%; right: auto; width: 37%; transform: rotate(0); }
  [data-variant*="kzms"]::before { opacity: 0.32; background-size: 1.2rem 1.2rem; }
  [data-variant*="endokey"] .field-orbit { width: 10rem; border-style: dashed; }
  [data-variant*="lab"] .field-bars { left: 9%; right: 9%; height: 52%; justify-content: space-between; }
  [data-variant*="lab"] .field-bars i { height: calc(12% + (var(--i) % 7) * 13%); }
  [data-variant*="giulia"] .field-orbit { border-radius: 42% 58% 48% 52%; transform: translate(-50%, -50%) rotate(24deg); }

  [data-variant="service-brand"] .field-orbit { left: 31%; width: 6.6rem; }
  [data-variant="service-brand"] .field-core { top: 31%; left: 66%; width: 2.4rem; border-radius: 0; transform: rotate(45deg); }
  [data-variant="service-brand"] .field-bars { right: 8%; left: auto; }
  [data-variant="service-site"] .field-orbit { border-radius: 0; }
  [data-variant="service-site"] .field-orbit::before { border-style: solid; border-radius: 0; }
  [data-variant="service-site"] .field-core { top: 49%; left: 49%; border-radius: 0; }
  [data-variant="service-connect"] .field-orbit { left: 50%; width: 4.5rem; }
  [data-variant="service-connect"] .field-orbit::before { inset: -90%; border: 1px dashed rgb(255 255 255 / 0.28); }
  [data-variant="service-connect"] .trace-a { top: 22%; right: 13%; width: 30%; }
  [data-variant="service-connect"] .trace-b { right: 11%; bottom: 17%; width: 31%; }

  [data-variant="case-kzms"]::before { opacity: 0.42; background-size: 0.85rem 0.85rem; mask-image: linear-gradient(90deg, black, rgb(0 0 0 / 0.25)); }
  [data-variant="case-kzms"] .field-orbit { left: 64%; width: 11rem; border-radius: 0; transform: translate(-50%, -50%) skew(-12deg); }
  [data-variant="case-kzms"] .field-orbit::before { border-radius: 0; }
  [data-variant="case-kzms"] .field-bars { top: 10%; bottom: auto; left: 13%; height: 80%; transform: rotate(63deg); }
  [data-variant="case-endokey"] .field-orbit { left: 58%; width: 13rem; border-width: 2px; }
  [data-variant="case-endokey"] .field-orbit::before { inset: 27%; border-style: solid; box-shadow: 0 0 0 2rem rgb(255 47 146 / 0.035), 0 0 0 4rem rgb(255 47 146 / 0.025); }
  [data-variant="case-endokey"] .field-axis { left: 4%; width: 92%; transform-origin: 58% 50%; }
  [data-variant="case-povkh-lab"] .field-orbit, [data-variant="case-povkh-lab"] .field-core { display: none; }
  [data-variant="case-povkh-lab"] .field-bars { top: 16%; right: 8%; bottom: 16%; left: 8%; height: auto; align-items: center; justify-content: space-between; }
  [data-variant="case-povkh-lab"] .field-bars i { width: 0.45rem; border-radius: 999px; background: var(--field-accent); opacity: 0.9; }
  [data-variant="case-povkh-lab"] .field-bars i:nth-child(1), [data-variant="case-povkh-lab"] .field-bars i:nth-child(12) { height: 18%; }
  [data-variant="case-povkh-lab"] .field-bars i:nth-child(2), [data-variant="case-povkh-lab"] .field-bars i:nth-child(11) { height: 34%; }
  [data-variant="case-povkh-lab"] .field-bars i:nth-child(3), [data-variant="case-povkh-lab"] .field-bars i:nth-child(10) { height: 62%; }
  [data-variant="case-povkh-lab"] .field-bars i:nth-child(4), [data-variant="case-povkh-lab"] .field-bars i:nth-child(9) { height: 42%; }
  [data-variant="case-povkh-lab"] .field-bars i:nth-child(5), [data-variant="case-povkh-lab"] .field-bars i:nth-child(8) { height: 78%; }
  [data-variant="case-povkh-lab"] .field-bars i:nth-child(6), [data-variant="case-povkh-lab"] .field-bars i:nth-child(7) { height: 96%; }
  [data-variant="case-povkh-lab"] .field-axis { top: 50%; left: 8%; width: 84%; transform: none; }
  [data-variant="case-giulia"] .field-orbit { top: 44%; left: 62%; width: 12rem; border-color: rgb(255 255 255 / 0.42); }
  [data-variant="case-giulia"] .field-orbit::before { inset: 10% 28%; border-style: solid; border-radius: 48%; }
  [data-variant="case-giulia"] .field-bars { transform: rotate(-12deg); }

  [data-variant="format-stage-2"] .field-orbit, [data-variant="process-stage-2"] .field-orbit { left: 48%; }
  [data-variant="format-stage-3"] .field-orbit, [data-variant="process-stage-3"] .field-orbit { left: 32%; border-radius: 0; }
  [data-variant="format-stage-4"] .field-orbit, [data-variant="process-stage-4"] .field-orbit { left: 76%; width: 4rem; }
  [data-variant="format-stage-5"] .field-orbit, [data-variant="process-stage-5"] .field-orbit { left: 50%; width: 10rem; border-style: dashed; }
  [data-variant="blog-note-02"] .field-orbit { left: 38%; border-radius: 0; transform: translate(-50%, -50%) rotate(45deg); }
  [data-variant="blog-note-03"] .field-orbit { left: 74%; width: 5rem; }
  [data-variant="studio-network"] .field-orbit { left: 50%; width: 4rem; }
  [data-variant="studio-network"] .field-orbit::before { inset: -110%; }
  [data-variant="studio-proof"] .field-orbit { border-radius: 0; transform: translate(-50%, -50%) rotate(45deg); }

  @media (max-width: 40rem) {
    .signal-field { min-height: 9.5rem; }
    .compact { min-height: 7.5rem; }
    .field-orbit { left: 72%; width: 6.5rem; }
  }
</style>
