      .reference-editorial.editorial-homepage .site-nav { height: 52px; }
      .reference-editorial.editorial-homepage .hero { padding-top: 0; }
      .reference-editorial.editorial-homepage .hero-copy { min-height: 40rem; }
      .reference-editorial.editorial-homepage .hero h1 { max-width: 9ch; font-size: clamp(3.2rem, 17vw, 4.8rem); line-height: .78; }
      .reference-editorial.editorial-homepage .hero-bottom { grid-template-columns: 1fr; gap: 20px; }
      .reference-editorial.editorial-homepage .hero-art { min-height: 29rem; }
      .reference-editorial.editorial-homepage .atlas-shot { grid-template-rows: 26px 1fr; }
      .reference-editorial.editorial-homepage .atlas-kzms { top: 11%; left: 4%; width: 72%; height: 40%; }
      .reference-editorial.editorial-homepage .atlas-endokey { top: 34%; right: 2%; width: 63%; height: 39%; }
      .reference-editorial.editorial-homepage .atlas-lab { bottom: 7%; left: 9%; width: 58%; height: 31%; }
      .reference-editorial.editorial-homepage .atlas-range { font-size: 7px; }
      .reference-editorial.editorial-homepage #problems .problems { grid-template-columns: 1fr; }
      .reference-editorial.editorial-homepage #problems .problem:nth-child(n) { min-height: 19rem; }
      .reference-editorial.editorial-homepage #problems .problem:nth-child(1) { min-height: 32rem; }
      .reference-editorial.editorial-homepage .section-head { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      .reference-editorial.editorial-homepage .atlas-shot { transition: none; will-change: auto; }
    }
  </style>
  <Fragment set:html={editorialMarkup} />
  <Footer locale="ru" />
  <script is:inline>
    const heroMedia = document.querySelector("[data-home-hero-media]");
    if (heroMedia instanceof HTMLElement && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      let atlasFrame;
      const resetAtlas = () => {
        cancelAnimationFrame(atlasFrame);
        heroMedia.style.setProperty("--atlas-x", "0");
        heroMedia.style.setProperty("--atlas-y", "0");
      };
      heroMedia.addEventListener("pointermove", (event) => {
        if (event.pointerType === "touch") return;
        cancelAnimationFrame(atlasFrame);
        atlasFrame = requestAnimationFrame(() => {
          const bounds = heroMedia.getBoundingClientRect();
          heroMedia.style.setProperty("--atlas-x", String(((event.clientX - bounds.left) / bounds.width - .5) * 2));
          heroMedia.style.setProperty("--atlas-y", String(((event.clientY - bounds.top) / bounds.height - .5) * 2));
        });
      });
      heroMedia.addEventListener("pointerleave", resetAtlas);
    }
  </script>
  <script is:inline set:html={editorialScript}></script>
</BaseLayout>
