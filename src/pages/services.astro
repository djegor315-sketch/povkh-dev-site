---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getServices, getSite } from "../lib/content";
import unboundedLatin from "../assets/fonts/unbounded-latin-wght-normal.woff2?url";
import plexSansLatin from "../assets/fonts/ibm-plex-sans-latin-wght-normal.woff2?url";
import plexMonoLatin from "../assets/fonts/ibm-plex-mono-latin-500-normal.woff2?url";

const locale = "en" as const;
const currentPath = "/services/";
const site = await getSite(locale);
const services = await getServices(locale);
const serviceImages = [
  "/assets/editorial/service-brand.webp",
  "/assets/editorial/service-web.webp",
  "/assets/editorial/service-growth.webp",
];
const formats = [
  ["Discovery", "Research, boundaries, structure and a practical roadmap."],
  ["Brand System", "Strategy and an agreed set of identity artefacts."],
  ["Website", "A landing page or company website with defined pages and states."],
  ["Connected Website", "A website plus agreed forms, CRM, analytics or automation."],
  ["Evolution", "A bounded improvement package for an existing system."],
];
const exclusions = [
  "E-commerce with live payments and warehouse operations",
  "Complex web applications and personal accounts",
  "Enterprise integrations",
  "Full monthly SEO promotion",
  "Translation and localisation as a standalone service",
  "24/7 support, hosting administration and guaranteed SLA",
];
---

<BaseLayout
  locale={locale}
  currentPath={currentPath}
  title={`Services — ${site.meta.title}`}
  description="Brand, Web and Connect services with clear starting formats, inclusions and boundaries."
  preloadFonts={[unboundedLatin, plexSansLatin, plexMonoLatin]}
>
  <div class="info-page services-page">
    <section class="info-hero inner-hero-layout container" aria-labelledby="services-title">
      <figure class="editorial-hero-media"><img src="/assets/editorial/service-web-768.webp" srcset="/assets/editorial/service-web-768.webp 768w, /assets/editorial/service-web.webp 1536w" sizes="(max-width: 760px) 100vw, 50vw" alt="Architectural form representing a connected digital system" width="1536" height="1024" decoding="sync" fetchpriority="high" /></figure>
      <div class="inner-hero-copy services-hero-copy">
        <p class="eyebrow">01 / Service systems</p>
        <h1 id="services-title">Services</h1>
        <p class="info-lede">{services.intro}</p>
        <p class="info-note">We scope the work around a defined result, with one point of responsibility inside Povkh.Dev.</p>
      </div>
    </section>

    <section class="service-systems container" aria-labelledby="systems-title">
      <header class="section-heading">
        <p class="eyebrow">Brand × Web × Connect</p>
        <h2 id="systems-title">Three systems, one working outcome.</h2>
      </header>
      <div class="service-grid">
        {services.items.map((service, index) => (
          <article class="service-card">
            <div class="service-media" aria-hidden="true"><img src={serviceImages[index]} alt="" width="1536" height="1024" loading="lazy" decoding="async" /></div>
            <div class="service-card-copy">
            <p class="metadata">0{index + 1}</p>
            <h2>{service.title}</h2>
            <p class="service-situation">{service.situation}</p>
            <h3>Outcome</h3>
            <p>{service.outcome}</p>
            <h3>Includes</h3>
            <ul>{service.includes.map((item) => <li>{item}</li>)}</ul>
            <p class="service-boundary"><strong>Boundary:</strong> {service.boundary}</p>
            <a class="text-link" href="/contact/">{service.cta} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="formats-section container" aria-labelledby="formats-title">
      <header class="section-heading">
        <p class="eyebrow">Starting formats</p>
        <h2 id="formats-title">Five ways to begin</h2>
      </header>
      <ol class="formats-list">
        {formats.map(([title, description], index) => (
          <li>
            <span class="metadata">0{index + 1}</span>
            <div><h3>{title}</h3><p>{description}</p></div>
          </li>
        ))}
      </ol>
    </section>

    <section class="exclusions-section container" aria-labelledby="exclusions-title">
      <header class="section-heading">
        <p class="eyebrow">Scope is part of the service</p>
        <h2 id="exclusions-title">Outside the starting catalogue</h2>
      </header>
      <p>These areas are not fixed packages in the first release. They can be considered only after a separate review of platform, capability, risk and partners.</p>
      <ul class="exclusions-list">{exclusions.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section class="info-cta container" aria-labelledby="services-cta-title">
      <h2 id="services-cta-title">Have a specific outcome in mind?</h2>
      <p>Share the context, constraints and what needs to work next. We will propose a clear starting point.</p>
      <a class="button" href="/contact/">{site.hero.primaryCta}</a>
    </section>
  </div>
</BaseLayout>

<style>
  .info-page { border-bottom: 1px solid var(--ink); }
  .inner-hero-copy { grid-row: 1; grid-column: 1; }
  .editorial-hero-media { grid-row: 1; grid-column: 2; }
  .info-hero { padding-block: clamp(4rem, 10vw, 9rem) var(--space-8); }
  .info-hero h1 { max-width: 10ch; margin-block: var(--space-4) var(--space-5); font-family: var(--font-display); font-size: clamp(3rem, 9vw, 7rem); letter-spacing: -0.07em; line-height: 0.95; }
  .info-lede { max-width: 42rem; margin-block-end: var(--space-3); font-size: clamp(1.25rem, 2.3vw, 2rem); line-height: 1.25; }
  .info-note { max-width: 38rem; color: var(--muted); }
  .service-systems, .formats-section, .exclusions-section { padding-block: var(--space-8); border-top: 1px solid var(--ink); }
  .section-heading { margin-block-end: var(--space-6); }
  .section-heading h2 { max-width: 20ch; margin-block: var(--space-3) 0; font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 3.5rem); letter-spacing: -0.06em; line-height: 1; }
  .service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; border: 1px solid var(--ink); background: var(--ink); }
  .service-card { display: flex; min-width: 0; padding: var(--space-5); flex-direction: column; background: var(--paper); }
  .service-card h2 { margin-block: var(--space-3) var(--space-4); font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.5rem); letter-spacing: -0.06em; }
  .service-card h3 { margin-block: var(--space-5) var(--space-2); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .service-situation { min-height: 4.8rem; font-weight: 650; }
  .service-card ul { margin-block: 0; padding-inline-start: 1.2rem; }
  .service-boundary { margin-block: var(--space-5); padding-block-start: var(--space-4); border-top: 1px solid var(--line); color: var(--muted); font-size: 0.95rem; }
  .text-link { margin-block-start: auto; padding-block-start: var(--space-4); font-weight: 700; }
  .formats-list { display: grid; margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .formats-list li { display: grid; padding-block: var(--space-4); grid-template-columns: 4rem 1fr; gap: var(--space-4); border-bottom: 1px solid var(--line); }
  .formats-list h3 { margin: 0 0 var(--space-1); font-size: 1.3rem; }
  .formats-list p { margin: 0; }
  .exclusions-section > p { max-width: 48rem; }
  .exclusions-list { max-width: 48rem; margin-block: var(--space-5) 0; padding-inline-start: 1.2rem; columns: 2; column-gap: var(--space-7); }
  .exclusions-list li { break-inside: avoid; margin-block-end: var(--space-3); }
  .info-cta { display: grid; padding-block: var(--space-8); grid-template-columns: 2fr 2fr auto; align-items: end; gap: var(--space-5); }
  .info-cta h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.5rem); letter-spacing: -0.05em; line-height: 1; }
  .info-cta p { margin: 0; }
  @media (max-width: 56rem) { .inner-hero-copy { grid-row: 1; grid-column: 1; } .editorial-hero-media { grid-row: 2; grid-column: 1; } .service-grid { grid-template-columns: 1fr; } .service-situation { min-height: 0; } .info-cta { grid-template-columns: 1fr 1fr; } .info-cta .button { grid-column: 1 / -1; justify-self: start; } }
  @media (max-width: 36rem) { .exclusions-list { columns: 1; } .info-cta { grid-template-columns: 1fr; } }
</style>
